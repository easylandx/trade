# Clave de acceso a la app: opcional. Déjala vacía si solo la usáis en casa.
APP_USER=radar
APP_PASS=
DATA_SOURCE=demo          # demo | tasty
MIN_SCORE=75

# --- Tastytrade (solo con DATA_SOURCE=tasty). Rellénalo SOLO en tu .env, nunca en el código. ---
# my.tastytrade.com > Manage > My Profile > API > OAuth Applications:
# crea la aplicación con el scope "read" ÚNICAMENTE (sin "trade") y pulsa Manage > Create Grant.
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
TASTYTRADE_CLIENT_ID=      # opcional
# Producción (datos reales). Para pruebas sin datos reales: https://api.cert.tastyworks.com
TASTYTRADE_BASE_URL=https://api.tastyworks.com
